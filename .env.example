PROJECT_NAME="AI Interview Readiness Platform Engine"
DATABASE_URL="sqlite:///./interview_prototype.db"
OFFLINE_DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:54322/postgres"
# Or Postgres: postgresql://postgres:postgres@localhost:5432/interview_db

# LM Studio Local AI Configuration (Meta Llama 3.1 8B Instruct)
LM_STUDIO_BASE_URL="http://192.168.240.1:1234/v1"
LM_STUDIO_MODEL="meta-llama-3.1-8b-instruct"
LM_STUDIO_API_KEY="lm-studio"

# Optional Cloud Providers
GEMINI_API_KEY="your-gemini-api-key-here"
GEMINI_MODEL="gemini-3.6-flash"

GROQ_API_KEY="your-groq-api-key-here"
GROQ_API_KEY_SECONDARY="your-second-groq-api-key-here"
GROQ_MODEL="llama-3.3-70b-versatile"

# Per-Task API Provider Chains (Comma-separated fallback order)
QUESTION_GEN_PROVIDERS="lm_studio,groq,gemini"
EVALUATION_PROVIDERS="lm_studio,groq,gemini"
ANALYSIS_PROVIDERS="lm_studio,groq,gemini"

AUDIO_STORAGE_DIR="./audio_storage"
USE_MOCK_SPEECH=False
WHISPER_MODEL_NAME="base"
WHISPER_MODELS_DIR="./models/whisper"
